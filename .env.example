# Домен сайта. A-запись (и AAAA, если есть IPv6) должна указывать на IP сервера.
DOMAIN=example.org

# Почта для уведомлений Let's Encrypt (истечение сертификата, изменения правил).
LETSENCRYPT_EMAIL=admin@example.org

# --- Режим «сайт-заглушка для REALITY» (README, раздел 8) ---
# Эти строки заполняет scripts/reality.sh enable; вручную их задавать не обязательно.
# COMPOSE_FILE=docker-compose.yml:docker-compose.reality.yml
# REALITY_TARGET_LISTEN=127.0.0.1:9443
# XHTTP_ENABLED=on
# XHTTP_PATH=/media/0123456789/
# XHTTP_UPSTREAM=127.0.0.1:2023
# SUB_ENABLED=on
# SUB_PATH=/a1b2c3d4/
# SUB_JSON_PATH=/e5f6a7b8/
# SUB_UPSTREAM=127.0.0.1:2096
